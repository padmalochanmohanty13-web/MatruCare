# Server Environment Variables
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/matrucare
JWT_SECRET=your_jwt_secret_key_here

# Nodemailer / Email Configuration
# Note: As per PDF instructions, use MatruCare AI as sender name and matrucareai@gmail.com
# EMAIL_PASS=your_gmail_app_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=matrucareai@gmail.com
SMTP_PASS=your_gmail_app_password
# RESEND_API_KEY=re_your_actual_private_key
EMAIL_FROM=matrucareai@gmail.com


# Client URL for CORS
CLIENT_URL=http://localhost:5173
